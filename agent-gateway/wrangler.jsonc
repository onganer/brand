{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enginar-agent-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "routes": [
    {
      "pattern": "theenginargroup.ltd.uk/*",
      "zone_name": "theenginargroup.ltd.uk"
    },
    {
      "pattern": "www.theenginargroup.ltd.uk/*",
      "zone_name": "theenginargroup.ltd.uk"
    }
  ]
}
